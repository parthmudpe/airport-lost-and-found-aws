# ============================================================
# Airport Lost & Found - Environment Configuration
# Copy this file to .env in /backend and fill in real values.
# NEVER commit a real .env file.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# --- Auth ---
# Used by the local JWT auth provider. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
AUTH_PROVIDER=local          # local | cognito

# --- AWS Cognito (used only when AUTH_PROVIDER=cognito) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# --- Storage ---
STORAGE_PROVIDER=local        # local | s3
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- AWS S3 (used only when STORAGE_PROVIDER=s3) ---
S3_BUCKET_NAME=
# Region falls back to AWS_REGION. Credentials: use an EC2 instance role - never put keys in this file.
S3_REGION=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300

# --- Database ---
DB_PROVIDER=sqlite            # sqlite | dynamodb
SQLITE_FILE=./data/lostfound.db

# --- AWS DynamoDB (used only when DB_PROVIDER=dynamodb) ---
DYNAMO_REGION=us-east-1
DYNAMO_TABLE_PREFIX=LostFound_

# --- Notifications ---
NOTIFICATION_PROVIDER=inapp   # inapp | ses_sns
SES_FROM_EMAIL=
SNS_TOPIC_ARN=

# --- Matching engine weights (must sum to <= 100). See docs/database.md ---
MATCH_WEIGHT_CATEGORY=15
MATCH_WEIGHT_BRAND=15
MATCH_WEIGHT_MODEL=15
MATCH_WEIGHT_COLOR=10
MATCH_WEIGHT_LOCATION=15
MATCH_WEIGHT_DATETIME=10
MATCH_WEIGHT_DESCRIPTION=10
MATCH_WEIGHT_SERIAL=10
MATCH_THRESHOLD_HIGH=80
MATCH_THRESHOLD_MEDIUM=60
MATCH_THRESHOLD_LOW=40
